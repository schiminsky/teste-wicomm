{
  "flex-layout.row#tab-home": {
    "title": "TabLayout",
    "props": {
      "blockClass": "home-tab-container"
    },
    "children": ["flex-layout.col#home-tabcontainer"]
  },
  "flex-layout.col#home-tabcontainer": {
    "props": {
      "blockClass": ["home-tab-layout-content", "tab-title"]
    },
    "children": [
      "flex-layout.row#home-tab-title",
      "flex-layout.row#home-tab-content"
    ]
  },
  "flex-layout.row#home-tab-title": {
    "props": {
      "blockClass": ["home-tab-layout-content", "tab-title"]
    },
    "children": ["rich-text#home-tab-title"]
  },
  "rich-text#home-tab-title": {
    "title": "Título - TabLayout",
    "props": {
      "textAlignment": "CENTER",
      "text": "PRODUTOS MAIS VENDIDOS",
      "blockClass": ["title-tablayout-home"]
    }
  },
  "flex-layout.row#home-tab-content": {
    "props": {
      "blockClass": ["home-tab-layout-content", "tab-layouts-content"]
    },
    "children": ["tab-layout#home-tab"]
  },
  "tab-layout#home-tab": {
    "children": ["tab-list#home-tab", "tab-content#home-tab"],
    "props": {
      "blockClass": "tab-home",
      "defaultActiveTabId": "home1"
    }
  },
  "tab-list#home-tab": {
    "children": [
      "tab-list.item#home1",
      "tab-list.item#home2",
      "tab-list.item#home3"
    ]
  },
  "tab-list.item#home1": {
    "props": {
      "tabId": "home1",
      "label": "DIFUSORES"
    }
  },
  "tab-list.item#home2": {
    "props": {
      "tabId": "home2",
      "label": "SABONETES"
    }
  },
  "tab-list.item#home3": {
    "props": {
      "tabId": "home3",
      "label": "ESSÊNCIAS"
    }
  },
  "tab-content#home-tab": {
    "children": [
      "tab-content.item#home1",
      "tab-content.item#home2",
      "tab-content.item#home3"
    ]
  },
  "tab-content.item#home1": {
    "children": [
      "flex-layout.row#tablayout-content1"
    ],
    "props": {
      "tabId": "home1"
    }
  },
  "flex-layout.row#tablayout-content1": {
    "title": "TabLayout 01",
    "props": {
      "blockClass": ["tab-content"]
    },
    "children": [
      "slider-layout#shelf-tablayout"
    ]
  },




    "tab-content.item#home2": {
    "children": [
      "flex-layout.row#tablayout-content2"
    ],
    "props": {
      "tabId": "home2"
    }
  },
  "flex-layout.row#tablayout-content2": {
    "title": "TabLayout 02",
    "props": {
      "blockClass": ["tab-content"]
    },
    "children": [
      "slider-layout#shelf-tablayout"
    ]
  },

  "tab-content.item#home3": {
    "children": [
      "flex-layout.row#tablayout-content3"
    ],
    "props": {
      "tabId": "home3"
    }
  },
  "flex-layout.row#tablayout-content3": {
    "title": "TabLayout 03",
    "props": {
      "blockClass": ["tab-content"]
    },
    "children": [
      "slider-layout#shelf-tablayout"
    ]
  },
  "slider-layout#shelf-tablayout": {
    "title": "Shelf TabLayout - slider config",
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 1,
        "phone": 1
      },
      "arrowSize": 12,
      "infinite": true,
      "fullWidth": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "blockClass": ["shelf-product", "shelf-tablayout"]
    },
    "children": [
      "image#difusores-1",
      "image#difusores-2",
      "image#difusores-3",
      "image#difusores-4",
      "image#difusores-1",
      "image#difusores-2",
      "image#difusores-3",
      "image#difusores-4",
      "image#difusores-1",
      "image#difusores-2",
      "image#difusores-3",
      "image#difusores-4"
    ]
  },
  "image#difusores-1": {
    "props": {
      "blockClass": "tab-images",
      "src": "https://i.ibb.co/N6S3PXPM/vitrine-1.png"
    }
  },
  "image#difusores-2": {
    "props": {
      "blockClass": "tab-images",
      "src": "https://i.ibb.co/tpgfKRc2/vitrine-2.png"
    }
  },
  "image#difusores-3": {
    "props": {
      "blockClass": "tab-images",
      "src": "https://i.ibb.co/MkfXt7Rf/vitrine-3.png"
    }
  },
  "image#difusores-4": {
    "props": {
      "blockClass": "tab-images",
      "src": "https://i.ibb.co/hxCpnS7y/vitrine-4.png"
    }
  }




















