{
  "flex-layout.row#category-home": {
    "props": {
      "blockClass": "category-home"
    },
    "children": [
      "flex-layout.col#category-home"
    ]
  },
  "flex-layout.col#category-home": {
    "props": {
      "blockClass": "category-home"
    },
    "children": [
      "rich-text#category-title",
      "flex-layout.row#category-menu-home"
    ]
  },
